# Try Bedrock first; restart the workflow on Gemini if an AWS model call fails.
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional Bedrock bearer token. Leave empty to use your existing AWS CLI credentials.
AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=your-profile-name

# Gemini fallback key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
