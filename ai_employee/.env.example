# Copy to .env. Defaults match the Nova Micro example in txtbase.txt.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional: select a profile from your existing AWS CLI configuration.
# AWS_PROFILE=your-profile-name

# Only needed if you use access keys instead of an AWS CLI login/profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
